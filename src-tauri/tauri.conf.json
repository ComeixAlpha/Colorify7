{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "colorify",
  "version": "../package.json",
  "identifier": "com.comeixalpha.colorify",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "colorify",
        "width": 800,
        "height": 600,
        "visible": false
      },
      {
        "label": "splash",
        "title": "colorify",
        "width": 380,
        "height": 240,
        "resizable": false,
        "decorations": false,
        "center": true,
        "skipTaskbar": true,
        "url": "splash.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
